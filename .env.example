# NightKit environment variables (copy to .env for local dev, set in Render for prod)

# Ideogram image-edit API key (required for /api/generate to produce flyers)
IDEOGRAM_API_KEY=

# Anthropic API key (required for /api/caption — the Instagram caption generator)
ANTHROPIC_API_KEY=

# Replicate API token (required for /api/remove — the LaMa "clean remove" tool).
# LaMa-Inpainting via zylim0702/remove-object, ca. 0,0005 USD pro Lauf.
REPLICATE_API_TOKEN=

# FAL.ai key (required for /api/reframe — multi-format export via outpaint).
# FLUX.2 Pro Outpaint (fal-ai/flux-2-pro/outpaint), ca. 0,04–0,05 USD pro Bild.
FAL_KEY=

# OpenAI API key — zweite Bild-Engine "GPT Image" im Template Studio (Modus 1),
# als Vergleich zu Ideogram. Nutzt den Edit-/Image-to-Image-Endpunkt
# (/v1/images/edits) mit dem Original-Flyer als Referenz. Ohne Key bleibt die
# Engine deaktiviert (klare UI-Meldung). Hinweis: GPT Image braucht eine
# verifizierte OpenAI-Organisation.
OPENAI_API_KEY=
# Modell (Default gpt-image-1; in Prod auf gpt-image-2 gesetzt):
# OPENAI_IMAGE_MODEL=gpt-image-2
# Format: "auto" folgt dem 9:16-Original; nur setzen, um es fest vorzugeben:
# OPENAI_IMAGE_SIZE=auto
# Motiverhalt: "high" bewahrt Personen/Gesichter des Originals (Default, nötig
# damit der Edit das Motiv nicht neu malt). Nur ändern, um es zu testen:
# OPENAI_INPUT_FIDELITY=high

# Segmind API key — Bild-Engine "Nano Banana Pro" im Auto-Flow (Template Studio).
# Header x-api-key. Referenzbild + Prompt → neues Template (image_urls, 9:16).
# safety_tolerance 1 (strikt) … 6 (am wenigsten streng), Default 6 (permissivste
# Stufe, damit Club-Motive nicht unnötig geblockt werden):
SEGMIND_API_KEY=
# SEGMIND_SAFETY_TOLERANCE=6

# Supabase — protects /api/generate and tracks generations_count.
# SUPABASE_URL is the project URL; SUPABASE_SERVICE_KEY is the service_role
# secret (server only, never expose to the browser). When unset, auth is not
# enforced (local dev) and a warning is printed at startup.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: override the listen port (defaults to 3000)
# PORT=3000
