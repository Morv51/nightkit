# NightKit environment variables (copy to .env for local dev, set in Render for prod)

# Ideogram image-edit API key (required for /api/generate to produce flyers)
IDEOGRAM_API_KEY=

# Anthropic API key (required for /api/caption — the Instagram caption generator)
ANTHROPIC_API_KEY=

# Replicate API token (required for /api/remove — the LaMa "clean remove" tool).
# LaMa-Inpainting via zylim0702/remove-object, ca. 0,0005 USD pro Lauf.
REPLICATE_API_TOKEN=

# FAL.ai key (required for /api/reframe — multi-format export via outpaint).
# FLUX.2 Pro Outpaint (fal-ai/flux-2-pro/outpaint), ca. 0,04–0,05 USD pro Bild.
FAL_KEY=

# OpenAI API key — zweite Bild-Engine "GPT Image" im Template Studio (Modus 1),
# als Vergleich zu Ideogram. Nur dafür nötig; ohne Key bleibt die Engine
# deaktiviert (klare UI-Meldung). Modell optional via OPENAI_IMAGE_MODEL
# umstellbar (Default gpt-image-1). Hinweis: GPT Image braucht eine verifizierte
# OpenAI-Organisation.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# Supabase — protects /api/generate and tracks generations_count.
# SUPABASE_URL is the project URL; SUPABASE_SERVICE_KEY is the service_role
# secret (server only, never expose to the browser). When unset, auth is not
# enforced (local dev) and a warning is printed at startup.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: override the listen port (defaults to 3000)
# PORT=3000
